+static void
+split_step_spring (grub_gfxmenu_view_t view, int dt)
+{
+  int target_pos = view->selected * 1024;
+  int err = target_pos - view->split_pos;
+  int acc = err * 240 - view->split_vel * 24;
+  int target[3], c;
+  int step = grub_min (256, grub_max (16, dt * 3));
+
+  view->split_vel += acc * dt / 1000;
+  view->split_pos += view->split_vel * dt / 1000;
+  if (grub_abs (target_pos - view->split_pos) <= 4
+      && grub_abs (view->split_vel) <= 32)
+    {
+      view->split_pos = target_pos;
+      view->split_vel = 0;
+    }
+
+  grub_gfxmenu_entry_accent (grub_menu_get_entry (view->menu, view->selected), target);
+  if (!view->split_color_init)
+    {
+      for (c = 0; c < 3; c++)
+        view->split_color[c] = target[c] * 256;
+      view->split_color_init = 1;
+      return;
+    }
+  for (c = 0; c < 3; c++)
+    {
+      int diff = target[c] * 256 - view->split_color[c];
+      if (grub_abs (diff) <= 256)
+        view->split_color[c] = target[c] * 256;
+      else
+        view->split_color[c] += diff * step / 256;
+    }
+}
