+int
+grub_gfxmenu_font_size (grub_gfxmenu_view_t view, int base)
+{
+  const int sizes[] = { 12, 14, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128 };
+  int target = base * grub_min (view->screen.height * 1024 / 1080,
+                                view->screen.width * 1024 / 1280) / 1024;
+  unsigned i;
+  int result = sizes[0];
+  for (i = 0; i < ARRAY_SIZE (sizes); i++)
+    if (sizes[i] <= target) result = sizes[i];
+  return result;
+}
+
+/* Canvas recomputes child bounds on every paint. Update its layout inputs,
+   rather than temporary widget bounds that canvas would immediately replace. */
+static void
+caelestia_update_bounds (grub_gui_component_t component,
+                         const grub_video_rect_t *bounds)
+{
+  component->x = bounds->x;
+  component->y = bounds->y;
+  component->w = bounds->width;
+  component->h = bounds->height;
+  component->xfrac = component->yfrac = component->wfrac = component->hfrac = 0;
+}
+
+static void
+caelestia_layout (grub_gui_component_t component, void *data)
+{
+  grub_gfxmenu_view_t view = data;
+  const char *id = component->ops->get_id (component);
+  char font[48];
+  if (!id) return;
+  if (!grub_strcmp (id, "caelestia-brand"))
+    {
+      grub_snprintf (font, sizeof (font), "Caelestia Regular %d",
+                     grub_gfxmenu_font_size (view, 14));
+      component->ops->set_property (component, "font", font);
+    }
+  else if (!grub_strcmp (id, "caelestia-theme-switch"))
+    {
+      grub_snprintf (font, sizeof (font), "Caelestia Regular %d",
+                     grub_gfxmenu_font_size (view, 14));
+      component->ops->set_property (component, "font", font);
+    }
+  else if (!grub_strcmp (id, "caelestia-heading"))
+    {
+      grub_snprintf (font, sizeof (font), "Caelestia Regular %d",
+                     grub_gfxmenu_font_size (view, 32));
+      component->ops->set_property (component, "font", font);
+    }
+  else if (!grub_strcmp (id, "__timeout__"))
+    {
+      grub_snprintf (font, sizeof (font), "Caelestia Regular %d",
+                     grub_gfxmenu_font_size (view, 16));
+      component->ops->set_property (component, "font", font);
+    }
+  else if (!grub_strcmp (id, "caelestia-cards"))
+    {
+      grub_video_rect_t bounds;
+      int portrait = view->screen.width < view->screen.height;
+      bounds.x = view->screen.width * (portrait ? 7 : 55) / 100;
+      bounds.y = view->screen.height * (portrait ? 41 : 16) / 100;
+      bounds.width = view->screen.width * (portrait ? 86 : 40) / 100;
+      bounds.height = view->screen.height * (portrait ? 43 : 68) / 100;
+      caelestia_update_bounds (component, &bounds);
+    }
+  else if (!grub_strcmp (id, "caelestia-controls"))
+    {
+      grub_video_rect_t bounds;
+      int width = grub_min (view->screen.width * 90 / 100,
+                            640 * grub_max (810, view->screen.height) / 1080);
+      bounds.y = component->y + grub_fixed_sfs_multiply (view->screen.height, component->yfrac);
+      bounds.width = grub_max (160, width);
+      bounds.height = bounds.width / 16;
+      bounds.x = (view->screen.width - bounds.width) / 2;
+      caelestia_update_bounds (component, &bounds);
+    }
+}
