+static int
+entry_accent_family (grub_menu_entry_t entry)
+{
+  struct grub_menu_entry_class *c;
+  if (entry)
+    for (c = entry->classes; c; c = c->next)
+      {
+        if (!c->name)
+          continue;
+        if (!grub_strcmp (c->name, "arch") || !grub_strcmp (c->name, "archlinux")
+            || !grub_strcmp (c->name, "arch-linux") || !grub_strcmp (c->name, "artix")
+            || !grub_strcmp (c->name, "endeavouros") || !grub_strcmp (c->name, "nixos")
+            || !grub_strcmp (c->name, "gentoo") || !grub_strcmp (c->name, "void"))
+          return 1;
+        if (!grub_strcmp (c->name, "cachyos") || !grub_strcmp (c->name, "manjaro")
+            || !grub_strcmp (c->name, "opensuse") || !grub_strcmp (c->name, "suse")
+            || !grub_strcmp (c->name, "opensuse-tumbleweed")
+            || !grub_strcmp (c->name, "opensuse-leap") || !grub_strcmp (c->name, "mint")
+            || !grub_strcmp (c->name, "linuxmint") || !grub_strcmp (c->name, "alpine"))
+          return 2;
+        if (!grub_strcmp (c->name, "windows") || !grub_strcmp (c->name, "win")
+            || !grub_strcmp (c->name, "windows10") || !grub_strcmp (c->name, "windows11")
+            || !grub_strcmp (c->name, "fedora") || !grub_strcmp (c->name, "kubuntu")
+            || !grub_strcmp (c->name, "kdeneon") || !grub_strcmp (c->name, "neon"))
+          return 3;
+        if (!grub_strcmp (c->name, "ubuntu") || !grub_strcmp (c->name, "debian")
+            || !grub_strcmp (c->name, "pop") || !grub_strcmp (c->name, "popos")
+            || !grub_strcmp (c->name, "pop-os") || !grub_strcmp (c->name, "xubuntu")
+            || !grub_strcmp (c->name, "lubuntu"))
+          return 4;
+        if (!grub_strcmp (c->name, "recovery") || !grub_strcmp (c->name, "memtest"))
+          return 5;
+      }
+  if (entry && entry->submenu)
+    return 5;
+  return 0;
+}
