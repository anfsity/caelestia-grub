+void
+grub_gfxmenu_tick (void *data)
+{
+  grub_gfxmenu_view_t view = data;
+  const char *motion;
+  int target[3], target_pos;
+  int fast_anim;
+  grub_uint64_t now;
+  int min_dt, dt;
+
+  if (!view || !view->menu || view->menu->size <= 0 || !is_split_layout ())
+    return;
+
+  motion = grub_env_get ("caelestia_motion");
+  if (motion && grub_strcmp (motion, "0") == 0)
+    return;
+
+  target_pos = view->selected * 1024;
+  grub_gfxmenu_entry_accent (grub_menu_get_entry (view->menu, view->selected), target);
+  fast_anim = view->split_pos != target_pos || view->split_vel != 0
+    || view->split_scramble_fp < 1024
+    || view->split_ripple_active
+    || (view->split_color_init
+        && (view->split_color[0] != target[0] * 256
+            || view->split_color[1] != target[1] * 256
+            || view->split_color[2] != target[2] * 256));
+
+  now = grub_get_time_ms ();
+  min_dt = fast_anim ? 16 : 42;
+  if (now - view->split_last_tick < (grub_uint64_t) min_dt)
+    {
+      grub_millisleep (4);
+      return;
+    }
+  dt = (int) grub_min ((grub_uint64_t) 50, now - view->split_last_tick);
+  view->split_last_tick = now;
+
+  if (fast_anim)
+    split_step_spring (view, dt);
+  if (view->split_scramble_fp < 1024)
+    view->split_scramble_fp = grub_min (1024, view->split_scramble_fp + dt * 1024 / 180);
+  if (view->split_ripple_active && now - view->split_ripple_start >= 420)
+    view->split_ripple_active = 0;
+
+  grub_gfxmenu_redraw_menu (view);
+}
