+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Included by gui_list.c. Software-rendered carousel, bounded bitmap cache.
+ * No floating point, filesystem writes, menu model changes or boot commands.
+ */
+static void
+split_clear (list_impl_t self)
+{
+  grub_video_bitmap_destroy (self->split_cache.backdrop);
+  grub_video_bitmap_destroy (self->split_cache.corner_tl);
+  grub_video_bitmap_destroy (self->split_cache.corner_bl);
+  grub_video_bitmap_destroy (self->split_cache.corner_tr);
+  grub_video_bitmap_destroy (self->split_cache.corner_br);
+  grub_video_bitmap_destroy (self->split_cache.fillet_top);
+  grub_video_bitmap_destroy (self->split_cache.fillet_bot);
+  grub_memset (&self->split_cache, 0, sizeof (self->split_cache));
+}
+
+static void
+carousel_clear (list_impl_t self)
+{
+  int i, j;
+  for (i = 0; i < 7; i++)
+    {
+      for (j = 0; j < 17; j++)
+        {
+          grub_video_bitmap_destroy (self->carousel_cache[i].sizes[j]);
+          self->carousel_cache[i].sizes[j] = 0;
+        }
+      self->carousel_cache[i].entry = 0;
+    }
+  split_clear (self);
+}
+
+static struct grub_video_bitmap *
+carousel_icon (list_impl_t self, int index, int level, int maximum)
+{
+  int slot = index % 7, j;
+  grub_menu_entry_t entry = grub_menu_get_entry (self->view->menu, index);
+  struct grub_video_bitmap *source;
+  int size = maximum * (16 + level) / 32;
+
+  if (self->carousel_cache[slot].entry != entry
+      || self->carousel_cache[slot].maximum != maximum)
+    {
+      for (j = 0; j < 17; j++)
+        {
+          grub_video_bitmap_destroy (self->carousel_cache[slot].sizes[j]);
+          self->carousel_cache[slot].sizes[j] = 0;
+        }
+      self->carousel_cache[slot].entry = entry;
+      self->carousel_cache[slot].maximum = maximum;
+    }
+  if (!self->carousel_cache[slot].sizes[level])
+    {
+      source = get_item_icon (self, index);
+      if (!source)
+        {
+          struct grub_menu_entry_class generic = { .name = entry && entry->submenu ? "recovery" : "os", .next = 0 };
+          struct grub_menu_entry fallback = { .classes = &generic };
+          source = grub_gfxmenu_icon_manager_get_icon (self->icon_manager, &fallback);
+        }
+      if (source)
+        grub_video_bitmap_create_scaled (&self->carousel_cache[slot].sizes[level],
+                                         size, size, source,
+                                         GRUB_VIDEO_BITMAP_SCALE_METHOD_BEST);
+      /* Missing art never prevents booting or painting the title. */
+      grub_errno = GRUB_ERR_NONE;
+    }
+  return self->carousel_cache[slot].sizes[level];
+}
+
+static grub_font_t
+menu_get_font (grub_gfxmenu_view_t view, int base)
+{
+  char name[48];
+  grub_snprintf (name, sizeof (name), "Caelestia Regular %d",
+                 grub_gfxmenu_font_size (view, base));
+  return grub_font_get (name);
+}
+
+/* Titles are presentation copies: editing and booting still use entry->title.
+   GRUB's printf supports numeric precision but not the C printf "*" syntax. */
+static char *
+carousel_get_title (grub_font_t font, const char *source, int width)
+{
+  grub_size_t end = grub_strlen (source);
+  char *title = grub_malloc (end + sizeof ("..."));
+  int dots = grub_font_get_string_width (font, "...");
+  if (!title)
+    return 0;
+  grub_strcpy (title, source);
+  if (grub_font_get_string_width (font, title) <= width)
+    return title;
+  while (end && grub_font_get_string_width (font, title) > width - dots)
+    {
+      do { end--; } while (end && (title[end] & 0xc0) == 0x80);
+      title[end] = 0;
+    }
+  grub_strcpy (title + end, "...");
+  return title;
+}
+
+static void
+carousel_paint (list_impl_t self)
+{
+  grub_gfxmenu_view_t view = self->view;
+  int position = view->carousel_animating ? view->carousel_position : view->selected * 1024;
+  int focus = position / 1024;
+  int w = self->bounds.width, h = self->bounds.height;
+  int scale = grub_min (view->screen.height * 1024 / 1080,
+                        view->screen.width * 1024 / 1280);
+  int maximum = grub_min (256 * scale / 1024,
+                          grub_min (w * 25 / 100, h * 61 / 100));
+  int spacing = grub_min (w * 30 / 100, h * 82 / 100);
+  int i;
+  grub_video_rect_t saved;
+
+  grub_gui_set_viewport (&self->bounds, &saved);
+  for (i = grub_max (0, focus - 2); i <= grub_min (view->menu->size - 1, focus + 3); i++)
+    {
+      int delta = i * 1024 - position;
+      int distance = grub_abs (delta);
+      int level = 16 - grub_min (16, distance * 16 / 1024);
+      int size = maximum * (16 + level) / 32;
+      int x = w / 2 + delta * spacing / 1024;
+      int y = h * 44 / 100;
+      struct grub_video_bitmap *icon;
+      grub_menu_entry_t entry;
+      grub_font_t f;
+      int tw;
+      char *title;
+      if (distance > 1536 || x - size / 2 < 0 || x + size / 2 > w)
+        continue;
+      icon = carousel_icon (self, i, level, maximum);
+      if (icon)
+        grub_video_blit_bitmap (icon, GRUB_VIDEO_BLIT_BLEND,
+                                x - size / 2, y - size / 2, 0, 0, size, size);
+      entry = grub_menu_get_entry (view->menu, i);
+      if (!entry)
+        continue;
+      f = menu_get_font (view, i == view->selected ? 32 : 20);
+      /* Never pass signed coordinates to GRUB's unsigned viewport API.
+         Only complete columns are painted; no offscreen text can leak. */
+      {
+        /* The focused caption uses a separate row below its neighbours. */
+        int selected = i == view->selected;
+        int width = selected ? w * 94 / 100 : spacing * 90 / 100;
+        int left = (selected ? w / 2 : x) - width / 2;
+        int top = y + size / 2 + grub_max (14, h * 4 / 100);
+        int height = grub_font_get_ascent (f) + grub_font_get_descent (f) + 4;
+        grub_video_rect_t clip, title_saved;
+        if (left < 0 || left + width > w || top < 0 || top + height > h)
+          continue;
+        title = carousel_get_title (f, entry->title, width);
+        if (!title)
+          { grub_errno = GRUB_ERR_NONE; continue; }
+        tw = grub_font_get_string_width (f, title);
+        clip.x = left; clip.y = top; clip.width = width; clip.height = height;
+        grub_gui_set_viewport (&clip, &title_saved);
+        grub_font_draw_string (title, f,
+                               grub_video_map_rgba_color ((i == view->selected)
+                                 ? self->selected_item_color : self->item_color),
+                               grub_max (0, (width - tw) / 2),
+                               grub_font_get_ascent (f));
+        grub_gui_restore_viewport (&title_saved);
+        grub_free (title);
+      }
+    }
+  /* Discrete position marks are useful for menus longer than three entries. */
+  {
+    int unit = grub_max (2, 4 * scale / 1024);
+    int step = grub_max (10, 18 * scale / 1024);
+    int count = grub_min (9, view->menu->size);
+    int first = grub_max (0, grub_min (view->selected - 4, view->menu->size - count));
+    for (i = 0; i < count; i++)
+      grub_video_fill_rect (grub_video_map_rgba_color ((first + i == view->selected)
+                            ? self->selected_item_color : self->item_color),
+                            w / 2 - count * step / 2 + i * step, h - unit * 2,
+                            first + i == view->selected ? unit * 3 : unit, unit);
+  }
+  grub_gui_restore_viewport (&saved);
+}
+
+static void
+cards_draw_text (grub_font_t font, const char *source, grub_video_color_t color,
+                 int x, int baseline, int width)
+{
+  char *text = carousel_get_title (font, source, width);
+  if (!text)
+    { grub_errno = GRUB_ERR_NONE; return; }
+  grub_font_draw_string (text, font, color, x, baseline);
+  grub_free (text);
+}
+
+/* Three visible cards keep the artwork clear while allowing arbitrarily long
+   menus. This renderer owns its panel, row layout and text clipping; it shares
+   the same menu model and bounded icon cache with the carousel. */
+static void
+cards_paint (list_impl_t self)
+{
+  grub_gfxmenu_view_t view = self->view;
+  int w = self->bounds.width, h = self->bounds.height;
+  int scale = grub_min (view->screen.height * 1024 / 1080,
+                        view->screen.width * 1024 / 1280);
+  int pad = grub_max (12, w * 6 / 100);
+  int row_height = h * 16 / 100;
+  int row_gap = grub_max (8, h * 2 / 100);
+  int icon_pad = grub_max (6, row_height * 15 / 100);
+  int icon_size = grub_min (grub_max (24, 64 * scale / 1024), row_height - icon_pad * 2);
+  int count = grub_min (3, view->menu->size);
+  int first = grub_max (0, grub_min (view->selected - 1, view->menu->size - count));
+  int row_width = w - pad * 2;
+  int i;
+  char counter[32];
+  grub_font_t small = menu_get_font (view, 14);
+  grub_font_t heading = menu_get_font (view, 32);
+  grub_font_t item_font = menu_get_font (view, 20);
+  grub_font_t selected_font = menu_get_font (view, 24);
+  int text_width = row_width - icon_pad * 3 - icon_size;
+  grub_video_color_t ink = grub_video_map_rgba_color (self->item_color);
+  grub_video_color_t selected_ink = grub_video_map_rgba_color (self->selected_item_color);
+  grub_video_rect_t saved;
+  grub_gfxmenu_box_t panel;
+
+  if (!check_boxes (self))
+    return;
+  panel = self->menu_box;
+  grub_gui_set_viewport (&self->bounds, &saved);
+  panel->set_content_size (panel, w - panel->get_left_pad (panel) - panel->get_right_pad (panel),
+                          h - panel->get_top_pad (panel) - panel->get_bottom_pad (panel));
+  panel->draw (panel, 0, 0);
+  cards_draw_text (small, "FRIEREN", ink, pad,
+                   h * 9 / 100 + grub_font_get_ascent (small), row_width);
+  cards_draw_text (heading, "Choose your system", ink, pad,
+                   h * 16 / 100 + grub_font_get_ascent (heading), row_width);
+
+  for (i = 0; i < count; i++)
+    {
+      int index = first + i;
+      int selected = index == view->selected;
+      int top = h * 29 / 100 + i * (row_height + row_gap);
+      int text_left = pad + icon_pad * 2 + icon_size;
+      grub_menu_entry_t entry = grub_menu_get_entry (view->menu, index);
+      grub_gfxmenu_box_t row = selected ? self->selected_item_box : self->item_box;
+      grub_font_t font = selected ? selected_font : item_font;
+      struct grub_video_bitmap *icon = carousel_icon (self, index, 16, icon_size);
+
+      row->set_content_size (row, row_width - row->get_left_pad (row) - row->get_right_pad (row),
+                             row_height - row->get_top_pad (row) - row->get_bottom_pad (row));
+      row->draw (row, pad, top);
+      if (icon)
+        grub_video_blit_bitmap (icon, GRUB_VIDEO_BLIT_BLEND,
+                                pad + icon_pad, top + (row_height - icon_size) / 2,
+                                0, 0, icon_size, icon_size);
+      cards_draw_text (font, entry->title, selected ? selected_ink : ink,
+                       text_left, top + (row_height + grub_font_get_ascent (font)
+                                          - grub_font_get_descent (font)) / 2,
+                       text_width);
+    }
+  {
+    const char *title = grub_menu_get_entry (view->menu, view->selected)->title;
+    /* A clipped card gets a smaller detail line; short names appear once. */
+    if (grub_font_get_string_width (selected_font, title) > text_width)
+      cards_draw_text (small, title, ink, pad,
+                       h * 86 / 100 + grub_font_get_ascent (small), row_width);
+  }
+  grub_snprintf (counter, sizeof (counter), "%d / %d", view->selected + 1, view->menu->size);
+  cards_draw_text (small, counter, ink, pad,
+                   h * 93 / 100 + grub_font_get_ascent (small), row_width);
+  grub_gui_restore_viewport (&saved);
+}
+
+/* Pure-code dark/light monolith split theme. Zero external images: procedural
+   dot-matrix backdrop, 4x4 supersampled anti-aliased bridge corners/fillets,
+   7x7 dot-matrix OS glyphs, and non-blocking fixed-point spring animation. */
+static const grub_uint8_t split_glyph_arch[7]     = { 0x08, 0x1c, 0x14, 0x36, 0x22, 0x6b, 0x41 };
+static const grub_uint8_t split_glyph_cachyos[7]  = { 0x1e, 0x31, 0x60, 0x62, 0x60, 0x31, 0x1e };
+static const grub_uint8_t split_glyph_windows[7]  = { 0x77, 0x77, 0x77, 0x00, 0x77, 0x77, 0x77 };
+static const grub_uint8_t split_glyph_ubuntu[7]   = { 0x08, 0x36, 0x41, 0x41, 0x22, 0x5d, 0x00 };
+static const grub_uint8_t split_glyph_recovery[7] = { 0x00, 0x7f, 0x00, 0x7c, 0x00, 0x70, 0x00 };
+static const grub_uint8_t split_glyph_uefi[7]     = { 0x2a, 0x7f, 0x41, 0x49, 0x41, 0x7f, 0x2a };
+static const grub_uint8_t split_glyph_linux[7]    = { 0x08, 0x1c, 0x36, 0x6b, 0x36, 0x1c, 0x08 };
+
+static grub_font_t
+menu_get_mono_font (grub_gfxmenu_view_t view, int base)
+{
+  char name[48];
+  grub_snprintf (name, sizeof (name), "Caelestia Mono Regular %d",
+                 grub_min (96, grub_gfxmenu_font_size (view, base)));
+  return grub_font_get (name);
+}
+
+static const grub_uint8_t *
+split_entry_glyph (grub_menu_entry_t entry)
+{
+  struct grub_menu_entry_class *c;
+  if (entry)
+    for (c = entry->classes; c; c = c->next)
+      {
+        if (!c->name)
+          continue;
+        if (!grub_strcmp (c->name, "arch") || !grub_strcmp (c->name, "archlinux")
+            || !grub_strcmp (c->name, "arch-linux") || !grub_strcmp (c->name, "artix")
+            || !grub_strcmp (c->name, "endeavouros"))
+          return split_glyph_arch;
+        if (!grub_strcmp (c->name, "cachyos"))
+          return split_glyph_cachyos;
+        if (!grub_strcmp (c->name, "windows") || !grub_strcmp (c->name, "win")
+            || !grub_strcmp (c->name, "windows10") || !grub_strcmp (c->name, "windows11"))
+          return split_glyph_windows;
+        if (!grub_strcmp (c->name, "ubuntu") || !grub_strcmp (c->name, "kubuntu")
+            || !grub_strcmp (c->name, "xubuntu") || !grub_strcmp (c->name, "lubuntu")
+            || !grub_strcmp (c->name, "ubuntu-mate") || !grub_strcmp (c->name, "debian")
+            || !grub_strcmp (c->name, "pop") || !grub_strcmp (c->name, "popos")
+            || !grub_strcmp (c->name, "pop-os"))
+          return split_glyph_ubuntu;
+        if (!grub_strcmp (c->name, "recovery") || !grub_strcmp (c->name, "memtest"))
+          return split_glyph_recovery;
+        if (!grub_strcmp (c->name, "uefi") || !grub_strcmp (c->name, "efi")
+            || !grub_strcmp (c->name, "firmware"))
+          return split_glyph_uefi;
+      }
+  if (entry && entry->submenu)
+    return split_glyph_recovery;
+  return split_glyph_linux;
+}
+
+static const char *
+split_entry_tag (grub_menu_entry_t entry)
+{
+  struct grub_menu_entry_class *c;
+  if (entry && entry->submenu)
+    return "SUBMENU";
+  if (entry)
+    for (c = entry->classes; c; c = c->next)
+      {
+        if (!c->name)
+          continue;
+        if (!grub_strcmp (c->name, "arch") || !grub_strcmp (c->name, "archlinux")
+            || !grub_strcmp (c->name, "arch-linux"))
+          return "ARCH";
+        if (!grub_strcmp (c->name, "cachyos"))
+          return "CACHYOS";
+        if (!grub_strcmp (c->name, "windows") || !grub_strcmp (c->name, "win")
+            || !grub_strcmp (c->name, "windows10") || !grub_strcmp (c->name, "windows11"))
+          return "WINDOWS";
+        if (!grub_strcmp (c->name, "ubuntu"))
+          return "UBUNTU";
+        if (!grub_strcmp (c->name, "fedora"))
+          return "FEDORA";
+        if (!grub_strcmp (c->name, "debian"))
+          return "DEBIAN";
+        if (!grub_strcmp (c->name, "nixos"))
+          return "NIXOS";
+        if (!grub_strcmp (c->name, "uefi") || !grub_strcmp (c->name, "efi")
+            || !grub_strcmp (c->name, "firmware"))
+          return "FIRMWARE";
+        if (!grub_strcmp (c->name, "recovery") || !grub_strcmp (c->name, "memtest"))
+          return "RECOVERY";
+      }
+  return "SYSTEM";
+}
+
+static void
+split_parse_title (const char *src, char *primary, grub_size_t psize,
+                   char *detail, grub_size_t dsize)
+{
+  const char *open = grub_strstr (src, " (");
+  grub_size_t len = grub_strlen (src);
+  if (open && open > src && len > 3 && src[len - 1] == ')')
+    {
+      grub_size_t plen = (grub_size_t) (open - src);
+      grub_size_t dlen = len - plen - 3;
+      if (plen >= psize) plen = psize - 1;
+      if (dlen >= dsize) dlen = dsize - 1;
+      grub_memcpy (primary, src, plen);
+      primary[plen] = 0;
+      grub_memcpy (detail, open + 2, dlen);
+      detail[dlen] = 0;
+      return;
+    }
+  if (len >= psize) len = psize - 1;
+  grub_memcpy (primary, src, len);
+  primary[len] = 0;
+  if (dsize)
+    detail[0] = 0;
+}
+
+/* Type 0..3: convex rounded corners (TL, BL, TR, BR).
+   Type 4..5: concave seam fillets curving out of the right light monolith. */
+static struct grub_video_bitmap *
+split_make_corner (int size, int type)
+{
+  struct grub_video_bitmap *bmp = 0;
+  grub_uint8_t *data;
+  int px, py, sx, sy;
+  int r8 = size * 8;
+  int r2 = r8 * r8;
+  int cx = (type == 0 || type == 1) ? r8 : 0;
+  int cy = (type == 0 || type == 2 || type == 5) ? r8 : 0;
+  int concave = type >= 4;
+
+  if (size <= 0)
+    return 0;
+  if (grub_video_bitmap_create (&bmp, size, size, GRUB_VIDEO_BLIT_FORMAT_RGBA_8888))
+    {
+      grub_errno = GRUB_ERR_NONE;
+      return 0;
+    }
+  data = (grub_uint8_t *) bmp->data;
+  for (py = 0; py < size; py++)
+    for (px = 0; px < size; px++)
+      {
+        int hits = 0;
+        int idx = (py * size + px) * 4;
+        for (sy = 0; sy < 4; sy++)
+          for (sx = 0; sx < 4; sx++)
+            {
+              int dx = px * 8 + sx * 2 + 1 - cx;
+              int dy = py * 8 + sy * 2 + 1 - cy;
+              int inside = dx * dx + dy * dy <= r2;
+              if (concave ? !inside : inside)
+                hits++;
+            }
+        data[idx + 0] = 240;
+        data[idx + 1] = 237;
+        data[idx + 2] = 230;
+        data[idx + 3] = (grub_uint8_t) (hits * 255 / 16);
+      }
+  return bmp;
+}
+
+static void
+split_ensure_cache (list_impl_t self, int w, int h, int radius, int fillet, int spacing)
+{
+  int portrait = w < h;
+  int split_x = portrait ? 0 : w * 54 / 100;
+  int split_y = portrait ? h * 54 / 100 : 0;
+  struct grub_video_bitmap *bg = 0;
+
+  if (self->split_cache.width == w && self->split_cache.height == h
+      && self->split_cache.radius == radius && self->split_cache.fillet == fillet)
+    return;
+
+  split_clear (self);
+  self->split_cache.width = w;
+  self->split_cache.height = h;
+  self->split_cache.radius = radius;
+  self->split_cache.fillet = fillet;
+
+  self->split_cache.corner_tl = split_make_corner (radius, 0);
+  self->split_cache.corner_bl = split_make_corner (radius, 1);
+  self->split_cache.corner_tr = split_make_corner (radius, 2);
+  self->split_cache.corner_br = split_make_corner (radius, 3);
+  self->split_cache.fillet_top = split_make_corner (fillet, 4);
+  self->split_cache.fillet_bot = split_make_corner (fillet, 5);
+
+  if (grub_video_bitmap_create (&bg, w, h, GRUB_VIDEO_BLIT_FORMAT_RGB_888) == GRUB_ERR_NONE && bg)
+    {
+      grub_uint8_t *data = (grub_uint8_t *) bg->data;
+      int pitch = bg->mode_info.pitch;
+      int x, y;
+      for (y = 0; y < h; y++)
+        {
+          grub_uint8_t *row = data + y * pitch;
+          for (x = 0; x < w; x++)
+            {
+              int light = portrait ? (y >= split_y) : (x >= split_x);
+              row[x * 3 + 0] = light ? 240 : 13;
+              row[x * 3 + 1] = light ? 237 : 15;
+              row[x * 3 + 2] = light ? 230 : 20;
+            }
+        }
+      for (y = spacing; y < h - 1; y += spacing)
+        for (x = spacing; x < w - 1; x += spacing)
+          {
+            int light = portrait ? (y >= split_y) : (x >= split_x);
+            grub_uint8_t r = light ? 216 : 26;
+            grub_uint8_t g = light ? 212 : 30;
+            grub_uint8_t b = light ? 204 : 40;
+            int dy, dx;
+            for (dy = 0; dy < 2; dy++)
+              for (dx = 0; dx < 2; dx++)
+                {
+                  grub_uint8_t *p = data + (y + dy) * pitch + (x + dx) * 3;
+                  p[0] = r; p[1] = g; p[2] = b;
+                }
+          }
+      self->split_cache.backdrop = bg;
+    }
+  else
+    grub_errno = GRUB_ERR_NONE;
+}
+
+static void
+split_draw_dot_glyph (const grub_uint8_t *rows, int cx, int cy, int size,
+                      grub_video_color_t on, grub_video_color_t off)
+{
+  int step = grub_max (2, size / 7);
+  int dot = step >= 3 ? grub_max (2, step * 72 / 100) : 1;
+  int total = step * 7;
+  int ox = cx - total / 2 + (step - dot) / 2;
+  int oy = cy - total / 2 + (step - dot) / 2;
+  int x, y;
+  for (y = 0; y < 7; y++)
+    for (x = 0; x < 7; x++)
+      {
+        int active = (rows[y] >> (6 - x)) & 1;
+        grub_video_fill_rect (active ? on : off, ox + x * step, oy + y * step, dot, dot);
+      }
+}
+
+static void
+split_draw_brackets (int x, int y, int w, int h, int len, int thick,
+                     grub_video_color_t color)
+{
+  grub_video_fill_rect (color, x, y, len, thick);
+  grub_video_fill_rect (color, x, y, thick, len);
+  grub_video_fill_rect (color, x + w - len, y, len, thick);
+  grub_video_fill_rect (color, x + w - thick, y, thick, len);
+  grub_video_fill_rect (color, x, y + h - thick, len, thick);
+  grub_video_fill_rect (color, x, y + h - len, thick, len);
+  grub_video_fill_rect (color, x + w - len, y + h - thick, len, thick);
+  grub_video_fill_rect (color, x + w - thick, y + h - len, thick, len);
+}
+
+static void
+split_draw_bridge (list_impl_t self, int x, int y, int bw, int bh,
+                   int portrait, int split_x, grub_video_color_t paper,
+                   grub_video_color_t accent)
+{
+  int r = self->split_cache.radius;
+  int fr = self->split_cache.fillet;
+  int bar_h = grub_max (8, bh - 18);
+
+  if (portrait)
+    {
+      grub_video_fill_rect (paper, x + r, y, bw - r * 2, bh);
+      grub_video_fill_rect (paper, x, y + r, r, bh - r * 2);
+      grub_video_fill_rect (paper, x + bw - r, y + r, r, bh - r * 2);
+      if (self->split_cache.corner_tl)
+        grub_video_blit_bitmap (self->split_cache.corner_tl, GRUB_VIDEO_BLIT_BLEND,
+                                x, y, 0, 0, r, r);
+      if (self->split_cache.corner_bl)
+        grub_video_blit_bitmap (self->split_cache.corner_bl, GRUB_VIDEO_BLIT_BLEND,
+                                x, y + bh - r, 0, 0, r, r);
+      if (self->split_cache.corner_tr)
+        grub_video_blit_bitmap (self->split_cache.corner_tr, GRUB_VIDEO_BLIT_BLEND,
+                                x + bw - r, y, 0, 0, r, r);
+      if (self->split_cache.corner_br)
+        grub_video_blit_bitmap (self->split_cache.corner_br, GRUB_VIDEO_BLIT_BLEND,
+                                x + bw - r, y + bh - r, 0, 0, r, r);
+    }
+  else
+    {
+      /* Flush against split_x on the right with sculpted concave fillets. */
+      grub_video_fill_rect (paper, x + r, y, split_x - (x + r), bh);
+      grub_video_fill_rect (paper, x, y + r, r, bh - r * 2);
+      if (self->split_cache.corner_tl)
+        grub_video_blit_bitmap (self->split_cache.corner_tl, GRUB_VIDEO_BLIT_BLEND,
+                                x, y, 0, 0, r, r);
+      if (self->split_cache.corner_bl)
+        grub_video_blit_bitmap (self->split_cache.corner_bl, GRUB_VIDEO_BLIT_BLEND,
+                                x, y + bh - r, 0, 0, r, r);
+      if (self->split_cache.fillet_top && y - fr >= 0)
+        grub_video_blit_bitmap (self->split_cache.fillet_top, GRUB_VIDEO_BLIT_BLEND,
+                                split_x - fr, y - fr, 0, 0, fr, fr);
+      if (self->split_cache.fillet_bot && y + bh + fr <= (int) self->bounds.height)
+        grub_video_blit_bitmap (self->split_cache.fillet_bot, GRUB_VIDEO_BLIT_BLEND,
+                                split_x - fr, y + bh, 0, 0, fr, fr);
+    }
+  grub_video_fill_rect (accent, x + 5, y + (bh - bar_h) / 2, 4, bar_h);
+}
+
+static void
+split_draw_ripple (grub_gfxmenu_view_t view, int w, int h, int spacing,
+                   int portrait, int split_x, int split_y, int ox, int oy,
+                   const int accent[3])
+{
+  grub_uint64_t elapsed;
+  int max_r, rad, band, r_in2, r_out2, x0, x1, y0, y1, x, y;
+  int fade;
+
+  if (!view->split_ripple_active)
+    return;
+  elapsed = grub_get_time_ms () - view->split_ripple_start;
+  if (elapsed >= 420)
+    return;
+
+  max_r = (w + h) * 45 / 100;
+  rad = (int) (elapsed * (grub_uint64_t) max_r / 420);
+  band = spacing * 2;
+  fade = (int) ((420 - elapsed) * 255 / 420);
+  r_in2 = rad > band ? (rad - band) * (rad - band) : 0;
+  r_out2 = (rad + band) * (rad + band);
+
+  x0 = grub_max (spacing, ((ox - rad - band) / spacing) * spacing);
+  x1 = grub_min (w - 2, ox + rad + band);
+  y0 = grub_max (spacing, ((oy - rad - band) / spacing) * spacing);
+  y1 = grub_min (h - 2, oy + rad + band);
+
+  for (y = y0; y <= y1; y += spacing)
+    for (x = x0; x <= x1; x += spacing)
+      {
+        int dx = x - ox, dy = y - oy;
+        int d2 = dx * dx + dy * dy;
+        if (d2 >= r_in2 && d2 <= r_out2)
+          {
+            int light = portrait ? (y >= split_y) : (x >= split_x);
+            int br = light ? 216 : 26;
+            int bg = light ? 212 : 30;
+            int bb = light ? 204 : 40;
+            int mix = fade * 75 / 100;
+            grub_video_color_t c = grub_video_map_rgb (
+              (grub_uint8_t) (br + (accent[0] - br) * mix / 255),
+              (grub_uint8_t) (bg + (accent[1] - bg) * mix / 255),
+              (grub_uint8_t) (bb + (accent[2] - bb) * mix / 255));
+            grub_video_fill_rect (c, x, y, 2, 2);
+          }
+      }
+}
+
+static void
+split_draw_keys (grub_gfxmenu_view_t view, int cx, int y, int max_w,
+                 int light_bg, int nested)
+{
+  static const char *const keys_main[5] = { "\xe2\x86\x91\xe2\x86\x93", "Enter", "E", "C", "T" };
+  static const char *const labs_main[5] = { "Choose", "Boot", "Edit", "Console", "Theme" };
+  static const char *const keys_sub[6]  = { "\xe2\x86\x91\xe2\x86\x93", "Enter", "Esc", "E", "C", "T" };
+  static const char *const labs_sub[6]  = { "Choose", "Boot", "Back", "Edit", "Console", "Theme" };
+  const char *const *keys = nested ? keys_sub : keys_main;
+  const char *const *labs = nested ? labs_sub : labs_main;
+  int count = nested ? 6 : 5;
+  grub_font_t font = menu_get_mono_font (view, 12);
+  int asc = grub_font_get_ascent (font);
+  int desc = grub_font_get_descent (font);
+  int kh = asc + desc + 8;
+  int pad = 7, gap_kl = 6, gap_g = 16;
+  int kw[6], lw[6], total = 0, show_labels = 1, i, x;
+  grub_video_color_t border = light_bg ? grub_video_map_rgb (186, 182, 174)
+                                       : grub_video_map_rgb (46, 52, 66);
+  grub_video_color_t key_fg = light_bg ? grub_video_map_rgb (28, 30, 38)
+                                       : grub_video_map_rgb (204, 212, 226);
+  grub_video_color_t lab_fg = light_bg ? grub_video_map_rgb (114, 112, 107)
+                                       : grub_video_map_rgb (104, 112, 128);
+
+  for (i = 0; i < count; i++)
+    {
+      kw[i] = grub_max (kh, grub_font_get_string_width (font, keys[i]) + pad * 2);
+      lw[i] = grub_font_get_string_width (font, labs[i]);
+      total += kw[i] + gap_kl + lw[i];
+    }
+  total += gap_g * (count - 1);
+  if (total > max_w)
+    {
+      show_labels = 0;
+      gap_g = 10;
+      total = 0;
+      for (i = 0; i < count; i++)
+        total += kw[i];
+      total += gap_g * (count - 1);
+      if (total > max_w)
+        return;
+    }
+
+  x = cx - total / 2;
+  for (i = 0; i < count; i++)
+    {
+      int ky = y - kh / 2;
+      int tw = grub_font_get_string_width (font, keys[i]);
+      int base = y + (asc - desc) / 2;
+      grub_video_fill_rect (border, x, ky, kw[i], 1);
+      grub_video_fill_rect (border, x, ky + kh - 1, kw[i], 1);
+      grub_video_fill_rect (border, x, ky, 1, kh);
+      grub_video_fill_rect (border, x + kw[i] - 1, ky, 1, kh);
+      grub_font_draw_string (keys[i], font, key_fg, x + (kw[i] - tw) / 2, base);
+      if (show_labels)
+        {
+          grub_font_draw_string (labs[i], font, lab_fg, x + kw[i] + gap_kl, base);
+          x += kw[i] + gap_kl + lw[i] + gap_g;
+        }
+      else
+        x += kw[i] + gap_g;
+    }
+}
+
+static const grub_int8_t split_sin64[64] = {
+    0,  12,  25,  37,  49,  60,  71,  81,  90,  98, 106, 112, 117, 122, 125, 127,
+  127, 127, 125, 122, 117, 112, 106,  98,  90,  81,  71,  60,  49,  37,  25,  12,
+    0, -12, -25, -37, -49, -60, -71, -81, -90, -98,-106,-112,-117,-122,-125,-127,
+ -127,-127,-125,-122,-117,-112,-106, -98, -90, -81, -71, -60, -49, -37, -25, -12
+};
+
+static void
+split_scramble_title (const char *src, char *out, grub_size_t size, int fp)
+{
+  static const char glyphs[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/_-:.";
+  grub_size_t len = grub_strlen (src);
+  grub_size_t i;
+  if (len >= size)
+    len = size - 1;
+  if (fp >= 1024 || len == 0)
+    {
+      grub_memcpy (out, src, len);
+      out[len] = 0;
+      return;
+    }
+  for (i = 0; i < len; i++)
+    {
+      unsigned char ch = (unsigned char) src[i];
+      int reveal = (int) (i * 736 / len);
+      /* Only scramble printable ASCII so UTF-8 sequences stay intact. */
+      if (ch < 33 || ch > 126 || fp >= reveal + 288)
+        out[i] = (char) ch;
+      else if (fp >= reveal)
+        out[i] = glyphs[(i * 19 + (unsigned) (fp / 24) * 7) % (sizeof (glyphs) - 1)];
+      else
+        out[i] = '_';
+    }
+  out[len] = 0;
+}
+
+static void
+split_draw_wave (grub_gfxmenu_view_t view, int x0, int wy, int lw,
+                 grub_video_color_t line_c, grub_video_color_t glow_c,
+                 grub_video_color_t base_c)
+{
+  const char *motion = grub_env_get ("caelestia_motion");
+  int animated = !motion || grub_strcmp (motion, "0") != 0;
+  int phase = animated ? (int) ((grub_get_time_ms () / 36) & 63) : 10;
+  int kick = grub_min (12, grub_abs (view->split_vel) / 450);
+  int amp = 5 + kick;
+  int step = grub_max (3, lw / 96);
+  int prev_y = wy;
+  int x;
+
+  grub_video_fill_rect (base_c, x0, wy, lw, 1);
+  for (x = 0; x <= lw; x += step)
+    {
+      int env = split_sin64[(x * 31 / grub_max (1, lw)) & 63];
+      int s1 = split_sin64[((x * 192 / grub_max (1, lw)) - phase) & 63];
+      int s2 = split_sin64[((x * 384 / grub_max (1, lw)) + phase * 2) & 63];
+      int y = wy + ((s1 * 2 + s2) * env / 128) * amp / 384;
+      if (x > 0)
+        {
+          int y0 = grub_min (prev_y, y);
+          int yh = grub_max (2, grub_abs (y - prev_y) + 1);
+          int sx = x0 + x - step;
+          grub_video_fill_rect (glow_c, sx, y0 + 1, step, yh);
+          grub_video_fill_rect (line_c, sx, y0, step, yh);
+        }
+      prev_y = y;
+    }
+}
+
+static void
+split_paint (list_impl_t self)
+{
+  grub_gfxmenu_view_t view = self->view;
+  int w = self->bounds.width, h = self->bounds.height;
+  int portrait = w < h;
+  int split_x = portrait ? 0 : w * 54 / 100;
+  int split_y = portrait ? h * 54 / 100 : 0;
+  int dark_w = portrait ? w : split_x;
+  int dark_h = portrait ? split_y : h;
+  int scale = grub_min (h * 1024 / 1080, w * 1024 / 1280);
+  int spacing = grub_max (16, grub_min (24, grub_min (w, h) / 34));
+  int radius = grub_max (6, grub_min (12, 10 * scale / 1024));
+  int fillet = grub_max (8, grub_min (14, 12 * scale / 1024));
+  int pad_x = grub_max (18, grub_min (60, w * 48 / 1000));
+  int top_y = grub_max (26, grub_min (68, h * 75 / 1000));
+  int accent[3];
+  grub_video_color_t c_dark = grub_video_map_rgb (13, 15, 20);
+  grub_video_color_t c_paper = grub_video_map_rgb (240, 237, 230);
+  grub_video_color_t c_ink = grub_video_map_rgb (18, 20, 26);
+  grub_video_color_t c_ink_muted = grub_video_map_rgb (114, 112, 107);
+  grub_video_color_t c_dark_line = grub_video_map_rgb (34, 38, 48);
+  grub_video_color_t c_light_line = grub_video_map_rgb (212, 208, 200);
+  grub_video_color_t c_dark_muted = grub_video_map_rgb (110, 119, 136);
+  grub_video_color_t c_accent;
+  grub_font_t f_mono = menu_get_mono_font (view, 14);
+  grub_font_t f_row = menu_get_font (view, 22);
+  grub_menu_entry_t active;
+  grub_video_rect_t saved;
+  int visible, first, pos, i;
+  int list_top, list_bot, row_gap, row_h, total_h, start_y;
+  int bridge_y, bridge_h, bridge_mid;
+  char buf[32], primary[256], detail[256];
+
+  if (!view || !view->menu || view->menu->size <= 0)
+    return;
+
+  active = grub_menu_get_entry (view->menu, view->selected);
+  if (!active)
+    return;
+
+  if (view->split_color_init)
+    {
+      accent[0] = view->split_color[0] / 256;
+      accent[1] = view->split_color[1] / 256;
+      accent[2] = view->split_color[2] / 256;
+    }
+  else
+    {
+      grub_gfxmenu_entry_accent (active, accent);
+      view->split_color[0] = accent[0] * 256;
+      view->split_color[1] = accent[1] * 256;
+      view->split_color[2] = accent[2] * 256;
+      view->split_color_init = 1;
+    }
+  c_accent = grub_video_map_rgb ((grub_uint8_t) accent[0],
+                                 (grub_uint8_t) accent[1],
+                                 (grub_uint8_t) accent[2]);
+
+  split_ensure_cache (self, w, h, radius, fillet, spacing);
+  grub_gui_set_viewport (&self->bounds, &saved);
+
+  /* 1. Static dot-matrix monolith backdrop */
+  if (self->split_cache.backdrop)
+    grub_video_blit_bitmap (self->split_cache.backdrop, GRUB_VIDEO_BLIT_REPLACE,
+                            0, 0, 0, 0, w, h);
+  else if (portrait)
+    {
+      grub_video_fill_rect (c_dark, 0, 0, w, split_y);
+      grub_video_fill_rect (c_paper, 0, split_y, w, h - split_y);
+    }
+  else
+    {
+      grub_video_fill_rect (c_dark, 0, 0, split_x, h);
+      grub_video_fill_rect (c_paper, split_x, 0, w - split_x, h);
+    }
+
+  /* 2. Entry geometry on dark side */
+  visible = grub_min (portrait ? 4 : 6, view->menu->size);
+  pos = view->split_pos;
+  if (pos < 0) pos = 0;
+  if (pos > (view->menu->size - 1) * 1024) pos = (view->menu->size - 1) * 1024;
+  first = grub_max (0, grub_min ((pos + 512) / 1024 - visible / 2,
+                                 view->menu->size - visible));
+
+  list_top = top_y + 38;
+  list_bot = dark_h - (portrait ? 20 : 72);
+  row_gap = grub_max (6, grub_min (14, (list_bot - list_top) * 28 / 1000));
+  row_h = grub_max (38, grub_min (72, (list_bot - list_top - (visible - 1) * row_gap) / visible));
+  total_h = visible * row_h + (visible - 1) * row_gap;
+  start_y = list_top + grub_max (0, (list_bot - list_top - total_h) * 46 / 100);
+
+  {
+    int rel = pos - first * 1024;
+    int stretch = grub_min (9, grub_abs (view->split_vel) / 600);
+    if (rel < 0) rel = 0;
+    if (rel > (visible - 1) * 1024) rel = (visible - 1) * 1024;
+    bridge_y = start_y + rel * (row_h + row_gap) / 1024 - stretch / 2;
+    bridge_h = row_h + stretch;
+    if (bridge_y < list_top)
+      bridge_y = list_top;
+    if (bridge_y + bridge_h > list_bot)
+      bridge_h = list_bot - bridge_y;
+    bridge_mid = bridge_y + bridge_h / 2;
+  }
+
+  /* Optional expanding dot-matrix ripple from the seam */
+  split_draw_ripple (view, w, h, spacing, portrait, split_x, split_y,
+                     portrait ? w / 2 : split_x,
+                     portrait ? split_y : bridge_mid, accent);
+
+  /* 3. Dark side top header */
+  {
+    int asc = grub_font_get_ascent (f_mono);
+    int desc = grub_font_get_descent (f_mono);
+    int base = top_y + (asc - desc) / 2;
+    int right_x = dark_w - (portrait ? pad_x : 28);
+    int tw;
+    grub_video_fill_rect (c_accent, pad_x, top_y - 3, 6, 6);
+    grub_font_draw_string (view->nested ? "SUBMENU" : "BOOT", f_mono,
+                           grub_video_map_rgb (226, 232, 242), pad_x + 14, base);
+    grub_snprintf (buf, sizeof (buf), "%02d / %02d", view->selected + 1, view->menu->size);
+    tw = grub_font_get_string_width (f_mono, buf);
+    grub_font_draw_string (buf, f_mono, c_dark_muted, right_x - tw, base);
+    grub_video_fill_rect (c_dark_line, pad_x, top_y + 18, right_x - pad_x, 1);
+  }
+
+  /* 4. Subtle dark slot frames (unselected rows) + seamless light bridge */
+  {
+    int slot_w = portrait ? (w - pad_x * 2) : (split_x - pad_x - 24);
+    grub_video_color_t slot_border = grub_video_map_rgb (26, 30, 40);
+    for (i = 0; i < visible; i++)
+      {
+        int ry = start_y + i * (row_h + row_gap);
+        grub_video_fill_rect (slot_border, pad_x, ry, slot_w, 1);
+        grub_video_fill_rect (slot_border, pad_x, ry + row_h - 1, slot_w, 1);
+        grub_video_fill_rect (slot_border, pad_x, ry, 1, row_h);
+        grub_video_fill_rect (slot_border, pad_x + slot_w - 1, ry, 1, row_h);
+      }
+  }
+  split_draw_bridge (self, pad_x, bridge_y, w - pad_x * 2, bridge_h,
+                     portrait, split_x, c_paper, c_accent);
+
+  /* 5. Entry list */
+  {
+    int glyph_sz = grub_max (18, grub_min (28, row_h * 44 / 100));
+    int row_asc = grub_font_get_ascent (f_row);
+    int row_desc = grub_font_get_descent (f_row);
+    int mono_asc = grub_font_get_ascent (f_mono);
+    int mono_desc = grub_font_get_descent (f_mono);
+    int right_edge = (portrait ? w - pad_x : split_x - 24) - 12;
+
+    for (i = 0; i < visible; i++)
+      {
+        int idx = first + i;
+        int ry = start_y + i * (row_h + row_gap);
+        int mid = ry + row_h / 2;
+        int dist = grub_abs (idx * 1024 - pos);
+        int blend = dist < 640 ? (640 - dist) * 255 / 640 : 0;
+        grub_menu_entry_t entry = grub_menu_get_entry (view->menu, idx);
+        int tx = pad_x + 20;
+        int ink_v = 216 + (18 - 216) * blend / 255;
+        grub_video_color_t text_c = grub_video_map_rgb (
+          (grub_uint8_t) ink_v,
+          (grub_uint8_t) (ink_v + (blend > 128 ? 2 : 6)),
+          (grub_uint8_t) (ink_v + (blend > 128 ? 8 : 16)));
+        grub_video_color_t idx_c = blend > 128 ? c_accent : c_dark_muted;
+        grub_video_color_t dot_on = blend > 128 ? c_ink : grub_video_map_rgb (184, 192, 208);
+        grub_video_color_t dot_off = blend > 128 ? grub_video_map_rgb (218, 214, 206)
+                                                 : grub_video_map_rgb (26, 30, 40);
+        if (!entry)
+          continue;
+
+        grub_snprintf (buf, sizeof (buf), "%02d", idx + 1);
+        grub_font_draw_string (buf, f_mono, idx_c, tx, mid + (mono_asc - mono_desc) / 2);
+        tx += grub_font_get_string_width (f_mono, "00") + 16;
+
+        split_draw_dot_glyph (split_entry_glyph (entry), tx + glyph_sz / 2, mid,
+                              glyph_sz, dot_on, dot_off);
+        tx += glyph_sz + 16;
+
+        split_parse_title (entry->title, primary, sizeof (primary), detail, sizeof (detail));
+        if (right_edge > tx + 24)
+          cards_draw_text (f_row, primary, text_c, tx, mid + (row_asc - row_desc) / 2,
+                           right_edge - tx);
+      }
+  }
+
+  if (!portrait)
+    split_draw_keys (view, split_x / 2, h - 34, split_x - 24, 0, view->nested);
+
+  /* 6. Light side — clean target view with prototype animations */
+  {
+    int lx = portrait ? pad_x : split_x + grub_max (24, (w - split_x) * 10 / 100);
+    int lw = portrait ? (w - pad_x * 2) : (w - split_x - grub_max (48, (w - split_x) * 20 / 100));
+    int ltop = portrait ? (split_y + 24) : top_y;
+    int lbot = portrait ? (h - 56) : (h - 34);
+    int asc = grub_font_get_ascent (f_mono);
+    int desc = grub_font_get_descent (f_mono);
+    int hbase = ltop + (asc - desc) / 2;
+    const char *tag = split_entry_tag (active);
+    int tw, inv, ease_fp;
+    int box, hero_y, hero_h, rule_y, rule_w, wave_y, gauge_y, footer_top;
+    grub_font_t f_hero;
+    const char *sub;
+    char revealed[256];
+
+    /* Aligned top horizon bar — single clean OS class tag */
+    grub_font_draw_string (tag, f_mono, c_ink_muted, lx, hbase);
+    grub_video_fill_rect (c_light_line, lx, ltop + 18, lw, 1);
+
+    /* Bottom anchor coordinates (segmented bar + live oscilloscope wave) */
+    wave_y = lbot - 2;
+    gauge_y = wave_y - 24;
+    footer_top = gauge_y - (asc + desc + 14);
+
+    /* Hero block: bracketed dot emblem + scramble-reveal title + expanding rule */
+    split_parse_title (active->title, primary, sizeof (primary), detail, sizeof (detail));
+    sub = detail[0] ? detail : (active->submenu ? "Submenu" : 0);
+
+    {
+      static const int candidates[5] = { 64, 48, 40, 32, 24 };
+      int ci;
+      f_hero = menu_get_font (view, 24);
+      for (ci = 0; ci < 5; ci++)
+        {
+          grub_font_t try_f = menu_get_font (view, candidates[ci]);
+          if (try_f && grub_font_get_string_width (try_f, primary) <= lw)
+            {
+              f_hero = try_f;
+              break;
+            }
+        }
+    }
+
+    box = (portrait && (footer_top - ltop) < 250) ? 0
+          : grub_max (48, grub_min (80, grub_min (lw * 20 / 100, h * 11 / 100)));
+    hero_h = (box ? box + 28 : 0)
+           + grub_font_get_ascent (f_hero) + grub_font_get_descent (f_hero)
+           + (sub ? (asc + desc + 12) : 0) + 22;
+    hero_y = ltop + 28 + grub_max (0, (footer_top - (ltop + 28) - hero_h) * 44 / 100);
+
+    if (box > 0)
+      {
+        grub_video_fill_rect (grub_video_map_rgb (232, 228, 220), lx, hero_y, box, box);
+        split_draw_brackets (lx, hero_y, box, box, grub_max (8, box / 6), 2, c_ink);
+        split_draw_dot_glyph (split_entry_glyph (active), lx + box / 2, hero_y + box / 2,
+                              box * 60 / 100, c_ink, grub_video_map_rgb (212, 208, 200));
+        hero_y += box + 28;
+      }
+
+    split_scramble_title (primary, revealed, sizeof (revealed), view->split_scramble_fp);
+    cards_draw_text (f_hero, revealed, c_ink, lx, hero_y + grub_font_get_ascent (f_hero), lw);
+    hero_y += grub_font_get_ascent (f_hero) + grub_font_get_descent (f_hero);
+
+    if (sub)
+      {
+        hero_y += 10;
+        cards_draw_text (f_mono, sub, c_accent, lx, hero_y + asc, lw);
+        hero_y += asc + desc;
+      }
+
+    inv = 1024 - grub_max (0, grub_min (1024, view->split_scramble_fp));
+    ease_fp = 1024 - inv * inv / 1024 * inv / 1024;
+    rule_y = hero_y + 18;
+    rule_w = lw * (350 + 650 * ease_fp / 1024) / 1000;
+    grub_video_fill_rect (c_ink, lx, rule_y, rule_w, 2);
+    if (rule_w < lw)
+      grub_video_fill_rect (c_light_line, lx + rule_w, rule_y + 1, lw - rule_w, 1);
+
+    /* Bottom segmented countdown track + live oscilloscope waveform */
+    {
+      int blocks = 24, b_gap = 3;
+      int bw = grub_max (2, (lw - (blocks - 1) * b_gap) / blocks);
+      int bar_w = blocks * bw + (blocks - 1) * b_gap;
+      int filled_fp = 0, bi;
+
+      if (view->timeout_active && view->first_timeout > 0)
+        {
+          int total_ms = view->first_timeout * 1000;
